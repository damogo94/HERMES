# ============================================================
# HERMES — configuración
# Copia este archivo a .env y rellena lo necesario.
# En las fases 0–4 NO necesitas wallet ni claves de exchange.
# ============================================================

# ===== Seguridad (interruptor maestro) =====
# true  -> simula todo, NUNCA envía órdenes reales (paper trading).
# Mantener en true hasta validar la estrategia en las fases 0–4.
HERMES_DRY_RUN=true

# Venue activo (de momento solo polymarket; kalshi vendrá después)
HERMES_VENUE=polymarket

# ===== Límites de riesgo (USDC) — se aplican a partir de la fase 4 =====
HERMES_MAX_USD_PER_TRADE=10
HERMES_MAX_USD_PER_HOUR=50
HERMES_MAX_USD_TOTAL=200
HERMES_MAX_SLIPPAGE=0.03

# ===== Datos / runtime =====
HERMES_DATA_DIR=./data_store
HERMES_LOG_LEVEL=INFO
# RPC de Polygon (solo lectura on-chain; un endpoint público vale para empezar)
HERMES_POLYGON_RPC=https://polygon-rpc.com

# ===== Capa de inteligencia / LLM (señal, NO ejecuta) — fase 2 =====
# Solo puntúa oportunidades; nunca tiene autoridad para gastar.
# HERMES_LLM_API_KEY=
# HERMES_LLM_BASE_URL=https://openrouter.ai/api/v1
# HERMES_LLM_MODEL=google/gemini-3-flash-preview

# ===== Ejecución (SOLO fase 5 — wallet DESECHABLE) =====
# Déjalo en blanco ahora. NUNCA uses tu wallet principal.
# HERMES_PRIVATE_KEY=
# HERMES_PROXY_WALLET=
